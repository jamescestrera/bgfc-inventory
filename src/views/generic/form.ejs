<%- include('../partials/header') %><div class="card panel form-card"><form class="row g-3" method="post" action="<%= record?'/'+type+'/'+record.id:'/'+type %>"><% config.fields.forEach((f,n)=>{ const long=['description','address'].includes(f); %><div class="<%= long?'col-12':'col-md-6' %>"><label class="form-label text-capitalize"><%= f.replaceAll('_',' ') %><%= n<2?' *':'' %></label><% if(long){ %><textarea class="form-control" name="<%= f %>"><%= record?.[f]||'' %></textarea><% }else{ %><input class="form-control" name="<%= f %>" value="<%= record?.[f]||'' %>" <%= n<2?'required':'' %> <%= f==='email'?'type=email':'' %>><% } %></div><% }) %><div class="col-12 text-end"><a class="btn btn-light" href="/<%= type %>">Cancel</a> <button class="btn btn-primary">Save</button></div></form></div><%- include('../partials/footer') %>
