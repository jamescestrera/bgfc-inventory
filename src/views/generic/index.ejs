<%- include('../partials/header') %><div class="page-actions"><p class="text-muted mb-0">Manage active <%= title.toLowerCase() %>.</p><a class="btn btn-primary" href="/<%= type %>/create">Add <%= title.slice(0,-1) %></a></div><div class="card panel"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><% config.fields.forEach(f=>{ %><th><%= f.replaceAll('_',' ') %></th><% }) %><th>Created</th><th>Actions</th></tr></thead><tbody><% rows.forEach(r=>{ %><tr><% config.fields.forEach(f=>{ %><td><%= r[f]||'-' %></td><% }) %><td><%= new Date(r.created_at).toLocaleDateString() %></td><td class="text-nowrap"><a class="btn btn-sm btn-outline-primary" href="/<%= type %>/<%= r.id %>/edit">Edit</a> <form class="d-inline confirm-archive" method="post" action="/<%= type %>/<%= r.id %>/archive"><button class="btn btn-sm btn-outline-danger">Archive</button></form></td></tr><% }) %><% if(!rows.length){ %><tr><td colspan="9" class="empty">No records found.</td></tr><% } %></tbody></table></div></div><%- include('../partials/footer') %>
