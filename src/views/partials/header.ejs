<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> | BGFC Inventory</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="/css/style.css?v=2"></head><body>
<% if(user){ %><div class="layout"><aside class="sidebar"><a class="brand" href="/dashboard"><img src="/assets/images/bgfc-logo.png" alt="BGFC"><span><b>BGFC</b><small>Inventory System</small></span></a><nav>
<a class="nav-link <%= path==='/dashboard'?'active':'' %>" href="/dashboard">Dashboard</a>
<% if(user.role!=='STAFF'){ %><a class="nav-link" href="/items">Items</a><a class="nav-link" href="/categories">Categories</a><% } %>
<a class="nav-link" href="/inventory">Inventory</a><% if(user.role!=='STAFF'){ %><a class="nav-link" href="/stock-in">Stock In</a><% } %><a class="nav-link" href="/stock-out">Stock Out</a><% if(user.role!=='STAFF'){ %><a class="nav-link" href="/stock-adjustment">Stock Adjustment</a><% } %><a class="nav-link" href="/transactions">Transactions</a>
<% if(user.role!=='STAFF'){ %><a class="nav-link" href="/suppliers">Suppliers</a><a class="nav-link" href="/reports">Reports</a><% } %><% if(user.role==='ADMINISTRATOR'){ %><a class="nav-link" href="/departments">Departments</a><a class="nav-link" href="/users">Users & Roles</a><a class="nav-link" href="/audit-logs">Audit Logs</a><% } %>
</nav><div class="side-user"><b><%= user.fullName %></b><small><%= user.role.replaceAll('_',' ') %></small><form method="post" action="/logout"><button class="btn btn-sm btn-outline-light w-100 mt-2">Logout</button></form></div></aside><main><header class="topbar"><button class="btn btn-light d-lg-none" id="menu">☰</button><div><small>BGFC Inventory</small><h1><%= title %></h1></div><span class="badge text-bg-primary"><%= user.role.replaceAll('_',' ') %></span></header><div class="content"><% } %>
<% if(success?.length){ %><div class="alert alert-success alert-dismissible fade show"><%= success[0] %><button class="btn-close" data-bs-dismiss="alert"></button></div><% } %><% if(error?.length){ %><div class="alert alert-danger alert-dismissible fade show"><%= error[0] %><button class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
