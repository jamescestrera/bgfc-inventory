<%- include('../partials/header') %><div class="card panel form-card"><form class="row g-3" method="post" action="<%= item?'/items/'+item.id:'/items' %>"><% if(!item){ %><div class="col-md-6"><label class="form-label">Item Code *</label><input class="form-control" name="item_code" required placeholder="ITM-0001"></div><% } else { %><div class="col-md-6"><label class="form-label">Item Code</label><input class="form-control" value="<%= item.item_code %>" disabled></div><% } %><div class="col-md-6"><label class="form-label">Item Name *</label><input class="form-control" name="item_name" value="<%= item?.item_name||'' %>" required></div><div class="col-md-6"><label class="form-label">Category *</label><select class="form-select" name="category_id" required><option value="">Select category</option><% categories.forEach(c=>{ %><option value="<%= c.id %>" <%= String(item?.category_id)===String(c.id)?'selected':'' %>><%= c.category_name %></option><% }) %></select></div><div class="col-md-6"><label class="form-label">Unit *</label><input class="form-control" name="unit" value="<%= item?.unit||'' %>" required placeholder="Piece, Ream, Bottle"></div><div class="col-12"><label class="form-label">Description</label><textarea class="form-control" name="description"><%= item?.description||'' %></textarea></div><% if(!item){ %><div class="col-md-6"><label class="form-label">Initial Quantity *</label><input class="form-control" type="number" min="0" step="1" name="quantity" value="0" required></div><% } %><div class="col-md-6"><label class="form-label">Reorder Level *</label><input class="form-control" type="number" min="0" step="1" name="reorder_level" value="<%= item?.reorder_level??10 %>" required></div><div class="col-12 text-end"><a class="btn btn-light" href="/items">Cancel</a> <button class="btn btn-primary"><%= item?'Save Changes':'Create Item' %></button></div></form></div><%- include('../partials/footer') %>
