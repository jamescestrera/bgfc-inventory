<%- include('../partials/header') %><div class="card panel mb-4"><div class="card-body"><div class="d-flex justify-content-between"><div><span class="text-muted"><%= item.item_code %></span><h2><%= item.item_name %></h2></div><span class="badge status-<%= item.stock_status.replaceAll(' ','-').toLowerCase() %> h-100"><%= item.stock_status %></span></div><div class="row mt-3"><div class="col-md-3"><small>Category</small><p><%= item.category_name %></p></div><div class="col-md-3"><small>Available Quantity</small><p><b><%= item.quantity %> <%= item.unit %></b></p></div><div class="col-md-3"><small>Reorder Level</small><p><%= item.reorder_level %></p></div><div class="col-md-3"><a class="btn btn-outline-primary" href="/items/<%= item.id %>/edit">Edit Item</a></div></div><p><%= item.description||'No description.' %></p></div></div><div class="card panel"><div class="card-header">Recent Item Transactions</div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Date</th><th>Type</th><th>Quantity</th><th>Reference</th><th>User</th></tr></thead><tbody><% transactions.forEach(t=>{ %><tr><td><%= new Date(t.transaction_date).toLocaleString() %></td><td><%= t.transaction_type %></td><td><%= t.quantity %></td><td><%= t.reference_no||'-' %></td><td><%= t.full_name||'-' %></td></tr><% }) %></tbody></table></div></div><%- include('../partials/footer') %>
