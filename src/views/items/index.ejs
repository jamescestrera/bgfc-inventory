<%- include('../partials/header') %><div class="page-actions"><form class="filter-bar" method="get"><input class="form-control" name="search" placeholder="Search code, name, description" value="<%= filters.search %>"><select class="form-select" name="category"><option value="">All categories</option><% categories.forEach(c=>{ %><option value="<%= c.id %>" <%= String(filters.category)===String(c.id)?'selected':'' %>><%= c.category_name %></option><% }) %></select><select class="form-select" name="status"><option value="">All statuses</option><% ['In Stock','Low Stock','Out of Stock'].forEach(s=>{ %><option <%= filters.status===s?'selected':'' %>><%= s %></option><% }) %></select><button class="btn btn-outline-primary">Filter</button></form><a class="btn btn-primary" href="/items/create">Add Item</a></div><div class="card panel"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Item Code</th><th>Item Name</th><th>Category</th><th>Description</th><th>Unit</th><th>Quantity</th><th>Reorder Level</th><th>Status</th><th>Created</th><th>Actions</th></tr></thead><tbody><% items.forEach(i=>{ %><tr><td><b><%= i.item_code %></b></td><td><%= i.item_name %></td><td><%= i.category_name||'-' %></td><td class="text-truncate desc"><%= i.description||'-' %></td><td><%= i.unit %></td><td><%= i.quantity %></td><td><%= i.reorder_level %></td><td><span class="badge status-<%= i.stock_status.replaceAll(' ','-').toLowerCase() %>"><%= i.stock_status %></span></td><td><%= new Date(i.created_at).toLocaleDateString() %></td><td class="text-nowrap"><a class="btn btn-sm btn-outline-primary" href="/items/<%= i.id %>">View</a> <a class="btn btn-sm btn-outline-secondary" href="/items/<%= i.id %>/edit">Edit</a> <form class="d-inline confirm-delete" method="post" action="/items/<%= i.id %>/delete"><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr><% }) %><% if(!items.length){ %><tr><td colspan="10" class="empty">No items found.</td></tr><% } %></tbody></table></div></div><%- include('../partials/footer') %>
