<%- include('../partials/header') %><div class="page-actions"><p class="text-muted mb-0">Passwords are securely hashed and never displayed.</p><a class="btn btn-primary" href="/users/create">Create User</a></div><div class="card panel"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Full Name</th><th>Username</th><th>Email</th><th>Role</th><th>Status</th><th>Created</th><th>Actions</th></tr></thead><tbody><% users.forEach(u=>{ %><tr><td><b><%= u.full_name %></b></td><td><%= u.username %></td><td><%= u.email||'-' %></td><td><%= u.role.replaceAll('_',' ') %></td><td><span class="badge <%= u.status==='ACTIVE'?'text-bg-success':'text-bg-secondary' %>"><%= u.status %></span></td><td><%= new Date(u.created_at).toLocaleDateString() %></td><td><a class="btn btn-sm btn-outline-primary" href="/users/<%= u.id %>/edit">Edit</a></td></tr><% }) %></tbody></table></div></div><%- include('../partials/footer') %>
