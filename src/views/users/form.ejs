<%- include('../partials/header') %><div class="card panel form-card"><form class="row g-3" method="post" action="<%= user?'/users/'+user.id:'/users' %>"><div class="col-md-6"><label class="form-label">Full Name *</label><input class="form-control" name="full_name" value="<%= user?.full_name||'' %>" required></div><div class="col-md-6"><label class="form-label">Username *</label><input class="form-control" name="username" value="<%= user?.username||'' %>" <%= user?'disabled':'required' %>></div><div class="col-md-6"><label class="form-label">Email</label><input class="form-control" type="email" name="email" value="<%= user?.email||'' %>"></div><div class="col-md-6"><label class="form-label">Password <%= user?'(leave blank to keep current)':'*' %></label><input class="form-control" type="password" minlength="8" name="password" <%= user?'':'required' %>></div><div class="col-md-6"><label class="form-label">Role *</label><select class="form-select" name="role" required><% [['ADMINISTRATOR','Administrator'],['INVENTORY_OFFICER','Inventory Officer'],['STAFF','Staff']].forEach(r=>{ %><option value="<%= r[0] %>" <%= user?.role===r[0]?'selected':'' %>><%= r[1] %></option><% }) %></select></div><div class="col-md-6"><label class="form-label">Status *</label><select class="form-select" name="status"><option <%= user?.status==='ACTIVE'?'selected':'' %>>ACTIVE</option><option <%= user?.status==='INACTIVE'?'selected':'' %>>INACTIVE</option></select></div><div class="col-12 text-end"><a class="btn btn-light" href="/users">Cancel</a> <button class="btn btn-primary">Save User</button></div></form></div><%- include('../partials/footer') %>
