<%- include('../partials/header') %><div class="card panel"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>ID</th><th>User</th><th>Action</th><th>Module</th><th>Description</th><th>IP Address</th><th>Created At</th></tr></thead><tbody><% logs.forEach(l=>{ %><tr><td><%= l.id %></td><td><%= l.full_name||'System' %></td><td><span class="badge text-bg-light"><%= l.action %></span></td><td><%= l.module %></td><td><%= l.description %></td><td><%= l.ip_address||'-' %></td><td><%= new Date(l.created_at).toLocaleString() %></td></tr><% }) %></tbody></table></div></div><%- include('../partials/footer') %>
