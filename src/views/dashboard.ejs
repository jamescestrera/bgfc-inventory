<%- include('partials/header') %><div class="stat-grid"><% [['Total Items',stats.totalItems],['Total Stock Quantity',stats.totalStock],['Low Stock Items',stats.lowStock],['Total Transactions',stats.totalTransactions],['Total Categories',stats.totalCategories],['Total Suppliers',stats.totalSuppliers]].forEach(s=>{ %><div class="stat-card"><small><%= s[0] %></small><strong><%= Number(s[1]).toLocaleString() %></strong></div><% }) %></div><div class="row g-4"><div class="col-xl-8"><div class="card panel"><div class="card-header">Recent Transactions</div><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Date</th><th>Type</th><th>Item</th><th>Quantity</th><th>User</th></tr></thead><tbody><% recent.forEach(t=>{ %><tr><td><%= new Date(t.transaction_date).toLocaleString() %></td><td><span class="badge <%= t.transaction_type==='STOCK_IN'?'text-bg-success':t.transaction_type==='STOCK_OUT'?'text-bg-warning':'text-bg-info' %>"><%= t.transaction_type %></span></td><td><%= t.item_name %></td><td><%= t.quantity %></td><td><%= t.full_name||'-' %></td></tr><% }) %></tbody></table></div></div><div class="card panel mt-4"><div class="card-header">Stock Overview</div><div class="card-body chart-box"><canvas id="stockChart" data-in="<%= chartData.STOCK_IN %>" data-out="<%= chartData.STOCK_OUT %>"></canvas></div></div></div><div class="col-xl-4"><div class="card panel"><div class="card-header">Low Stock List</div><div class="list-group list-group-flush"><% low.forEach(i=>{ %><a href="/items" class="list-group-item"><b><%= i.item_name %></b><small class="d-block text-muted"><%= i.item_code %> · Available: <%= i.quantity %> · Reorder: <%= i.reorder_level %></small></a><% }) %><% if(!low.length){ %><div class="p-4 text-muted">No low-stock items.</div><% } %></div></div></div></div><script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.0/dist/chart.umd.min.js"></script><script>const c=document.getElementById('stockChart');new Chart(c,{type:'doughnut',data:{labels:['Stock In','Stock Out'],datasets:[{data:[c.dataset.in,c.dataset.out],backgroundColor:['#198754','#e6aa20']}]},options:{responsive:true,maintainAspectRatio:false}})</script><%- include('partials/footer') %>
