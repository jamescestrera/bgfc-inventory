<%- include('../partials/header') %><div class="page-actions"><h2><%= report.title %></h2><div><button class="btn btn-outline-secondary" onclick="print()">Print</button> <a class="btn btn-primary" href="/reports/<%= type %>/csv">Export CSV</a></div></div><div class="card panel"><div class="table-responsive"><table class="table table-striped mb-0"><thead><tr><% if(report.rows[0]) Object.keys(report.rows[0]).forEach(c=>{ %><th><%= c %></th><% }) %></tr></thead><tbody><% report.rows.forEach(r=>{ %><tr><% Object.values(r).forEach(v=>{ %><td><%= v??'-' %></td><% }) %></tr><% }) %></tbody></table></div></div><%- include('../partials/footer') %>
