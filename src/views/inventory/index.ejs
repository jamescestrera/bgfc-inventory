<%- include('../partials/header') %><div class="page-actions"><p class="text-muted mb-0">Live quantities calculated from database transactions.</p><div><% if(user.role!=='STAFF'){ %><a class="btn btn-success" href="/stock-in">Stock In</a><% } %> <a class="btn btn-warning" href="/stock-out">Stock Out</a></div></div><div class="card panel"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Item Code</th><th>Item Name</th><th>Category</th><th>Stock In</th><th>Stock Out</th><th>Available Quantity</th><th>Reorder Level</th><th>Status</th></tr></thead><tbody><% items.forEach(i=>{ %><tr><td><%= i.item_code %></td><td><b><%= i.item_name %></b></td><td><%= i.category_name||'-' %></td><td class="text-success">+<%= i.stock_in %></td><td class="text-danger">-<%= i.stock_out %></td><td><b><%= i.quantity %></b></td><td><%= i.reorder_level %></td><td><span class="badge status-<%= i.stock_status.replaceAll(' ','-').toLowerCase() %>"><%= i.stock_status %></span></td></tr><% }) %></tbody></table></div></div><%- include('../partials/footer') %>
