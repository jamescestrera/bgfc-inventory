<%- include('../partials/header') %><form class="filter-bar mb-3" method="get"><select class="form-select" name="type"><option value="">All types</option><% ['STOCK_IN','STOCK_OUT','ADJUSTMENT'].forEach(t=>{ %><option <%= filters.type===t?'selected':'' %>><%= t %></option><% }) %></select><select class="form-select" name="item"><option value="">All items</option><% items.forEach(i=>{ %><option value="<%= i.id %>" <%= String(filters.item)===String(i.id)?'selected':'' %>><%= i.item_name %></option><% }) %></select><% if(user.role==='ADMINISTRATOR'){ %><select class="form-select" name="user"><option value="">All users</option><% users.forEach(u=>{ %><option value="<%= u.id %>" <%= String(filters.user)===String(u.id)?'selected':'' %>><%= u.full_name %></option><% }) %></select><% } %><input class="form-control" type="date" name="from" value="<%= filters.from %>"><input class="form-control" type="date" name="to" value="<%= filters.to %>"><button class="btn btn-outline-primary">Filter</button></form><div class="card panel"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>ID</th><th>Date</th><th>Type</th><th>Item</th><th>Quantity</th><th>Supplier / Department</th><th>Reference</th><th>User</th><th>Remarks</th></tr></thead><tbody><% transactions.forEach(t=>{ %><tr><td><%= t.id %></td><td><%= new Date(t.transaction_date).toLocaleString() %></td><td><%= t.transaction_type %></td><td><%= t.item_name %></td><td><%= t.quantity %></td><td><%= t.supplier_name||t.department_name||'-' %></td><td><%= t.reference_no||'-' %></td><td><%= t.full_name||'-' %></td><td><%= t.remarks||'-' %></td></tr><% }) %></tbody></table></div></div><%- include('../partials/footer') %>
