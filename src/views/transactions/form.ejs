<%- include('../partials/header') %><div class="card panel form-card"><form class="row g-3" method="post"><div class="col-md-8"><label class="form-label">Item *</label><select class="form-select" name="item_id" id="item" required><option value="">Select item</option><% items.forEach(i=>{ %><option value="<%= i.id %>" data-qty="<%= i.quantity %>"><%= i.item_code %> — <%= i.item_name %> (Available: <%= i.quantity %>)</option><% }) %></select></div><div class="col-md-4"><label class="form-label">Date</label><input class="form-control" type="datetime-local" name="transaction_date"></div><% if(type==='ADJUSTMENT'){ %><div class="col-md-4"><label class="form-label">System Quantity</label><input class="form-control" id="systemQty" readonly value="Select an item"></div><div class="col-md-4"><label class="form-label">Actual Quantity *</label><input class="form-control" type="number" min="0" step="1" name="actual_quantity" required></div><div class="col-md-4"><label class="form-label">Reason *</label><select class="form-select" name="reason" required><% ['Physical Count','Damaged Item','Lost Item','Encoding Error','Returned Item','Other'].forEach(r=>{ %><option><%= r %></option><% }) %></select></div><% }else{ %><div class="col-md-6"><label class="form-label">Quantity *</label><input class="form-control" type="number" min="1" step="1" name="quantity" required></div><% if(type==='STOCK_IN'){ %><div class="col-md-6"><label class="form-label">Supplier</label><select class="form-select" name="supplier_id"><option value="">Select supplier</option><% suppliers.forEach(s=>{ %><option value="<%= s.id %>"><%= s.supplier_name %></option><% }) %></select></div><% }else{ %><div class="col-md-6"><label class="form-label">Department / Recipient *</label><select class="form-select" name="department_id" required><option value="">Select department</option><% departments.forEach(d=>{ %><option value="<%= d.id %>"><%= d.department_name %></option><% }) %></select></div><div class="col-12"><label class="form-label">Purpose *</label><input class="form-control" name="purpose" required></div><% } %><% } %><div class="col-md-6"><label class="form-label">Reference / Receipt Number</label><input class="form-control" name="reference_no"></div><div class="col-12"><label class="form-label">Remarks</label><textarea class="form-control" name="remarks"></textarea></div><div class="col-12 text-end"><a class="btn btn-light" href="/inventory">Cancel</a> <button class="btn btn-primary">Record <%= title %></button></div></form></div><%- include('../partials/footer') %>
